# ── Database ────────────────────────────────────────────────────────────────
# Plain Postgres:
DATABASE_URL="postgresql://openhosting:openhosting@localhost:5432/openhosting"
DIRECT_URL="postgresql://openhosting:openhosting@localhost:5432/openhosting"

# Supabase: use the pooled connection for DATABASE_URL and the direct
# connection for DIRECT_URL (migrations). Find both under
# Project Settings → Database → Connection string.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── App ─────────────────────────────────────────────────────────────────────
# Secret required by /api/cron (renewal invoicing, suspension). Generate with:
#   openssl rand -hex 32
CRON_SECRET="change-me"

# Optional: initial admin password used by `npm run db:seed`
# SEED_ADMIN_PASSWORD="change-me"

# ── Ticket attachment storage ───────────────────────────────────────────────
# Default: keep attachment bytes in PostgreSQL. Set to "s3" for AWS S3,
# Cloudflare R2, MinIO, Backblaze B2, or another S3-compatible private bucket.
ATTACHMENT_STORAGE="database"
# ATTACHMENT_S3_BUCKET="openhosting-private"
# ATTACHMENT_S3_REGION="us-east-1"
# ATTACHMENT_S3_ENDPOINT="https://s3.example.com"
# ATTACHMENT_S3_ACCESS_KEY_ID=""
# ATTACHMENT_S3_SECRET_ACCESS_KEY=""
# ATTACHMENT_S3_FORCE_PATH_STYLE="false"
# ATTACHMENT_S3_PREFIX="attachments"
# ATTACHMENT_S3_DOWNLOAD_TTL_SECONDS="300"
